# Configuração do ollama-node-monitor.
# Instalado em /etc/ollama-node-monitor/config.env (permissão 600, pois contém o token).

# Endereço da API do Ollama
OLLAMA_URL=http://127.0.0.1:11434

# Intervalo entre verificações, em segundos
POLL_INTERVAL=30

# Bot do Telegram (crie com o @BotFather). Deixe os dois vazios para só registrar no log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Nome do nó nas mensagens e métricas (padrão: hostname)
#NODE_NAME=gpu-01

# Arquivo de métricas para o textfile collector do node_exporter (vazio desativa)
#METRICS_FILE=/var/lib/node_exporter/textfile_collector/ollama.prom

# Avisar quando a API do Ollama cair e voltar
NOTIFY_API_DOWN=true

# CTID do container no Proxmox (detectado sozinho em containers LXC; defina para forçar)
#PROXMOX_CTID=105
